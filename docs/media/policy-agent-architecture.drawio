        <mxCell id="zaz" value="Azure Subscription" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f1;strokeColor=#4f8a80;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#33645b;align=center;pointerEvents=0;" parent="1" vertex="1">
          <mxGeometry x="760" y="-30" width="690" height="360" as="geometry" />
        </mxCell>
        <mxCell id="z1-pr" value="🔀 Pull Request" style="swimlane;startSize=28;fillColor=#ffffff;strokeColor=#5e6c84;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#42526e;rounded=1;html=1;" parent="1" vertex="1">
