          </mxGeometry>
        </mxCell>
        <mxCell id="z1-comment" value="&lt;b&gt;💬 Test Results&lt;/b&gt;&lt;br&gt;PASS or FAIL summary posted back to the PR comment and recorded into Test Evidence file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#5e6c84;strokeWidth=1;fontSize=10;fontColor=#42526e;align=center;verticalAlign=middle;" parent="z1-pr" vertex="1">
          <mxGeometry x="10" y="130" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="z1-policy" value="&lt;b&gt;📁 Policy Definitions (.JSON)&lt;/b&gt;&lt;br&gt;Custom policy definitions containing business rules and enforcement defaults" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e6c84;strokeWidth=1.5;fontSize=11;fontColor=#42526e;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="548" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z1-inst" value="&lt;b&gt;📁 Agent Instructions (.MD)&lt;/b&gt;&lt;br&gt;Perscriptive guidance that shapes how each agent behaves and the test contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e6c84;strokeWidth=1.5;fontSize=11;fontColor=#42526e;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="628" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z1-evidence" value="&lt;b&gt;📁 Test Evidence (.MD)&lt;/b&gt;&lt;br&gt;Records prior test outcomes so unchanged policies are not retested unneccessarily" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e6c84;strokeWidth=1.5;fontSize=11;fontColor=#42526e;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="708" width="220" height="68" as="geometry" />
        </mxCell>
        <mxCell id="z2-validate" value="&lt;b&gt;(2) Validate &amp;amp; Plan&lt;/b&gt;&lt;br&gt;Validates policy definitions, skips policies with existing test evidence, routes policies to correct foundry agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a6fa5;strokeWidth=1.5;fontSize=11;fontColor=#33507a;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="360" y="70" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="z2-test" value="&lt;b&gt;(3) Test Policies&lt;/b&gt;&lt;br&gt;Orchestrates provisioning of new ephemeral agent per policy, exchange of policy data to agent, executes azcli script on target subscription, collects test results&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a6fa5;strokeWidth=1.5;fontSize=11;fontColor=#33507a;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="360" y="200" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="z2-report" value="&lt;b&gt;(7) Report &amp;amp; Record&lt;/b&gt;&lt;br&gt;Combines all test results, records results and evidence in the PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a6fa5;strokeWidth=1.5;fontSize=11;fontColor=#33507a;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="360" y="408" width="320" height="88" as="geometry" />
        </mxCell>
        <mxCell id="z2-improve" value="&lt;b&gt;(9) Improve Instructions&lt;/b&gt;&lt;br&gt;Orchestrates passing test results to instructions maintenance agent and creating a new PR if improvements are found" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a6fa5;strokeWidth=1.5;fontSize=11;fontColor=#33507a;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="360" y="562" width="320" height="84" as="geometry" />
        </mxCell>
        <mxCell id="z2-cleanup" value="&lt;b&gt;(13) Final Clean Up&lt;/b&gt;&lt;br&gt;Removes any leftover test resources in Azure or ephemeral agents in Foundry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a6fa5;strokeWidth=1.5;fontSize=11;fontColor=#33507a;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="360" y="704" width="320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="z3-agents" value="&lt;b&gt;Specialised Agents (prompt-based)&lt;/b&gt;&lt;br&gt;Deny · Audit · DINE · Modify&lt;br&gt;1x baseline agent per policy effect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b5b95;strokeWidth=1.5;fontSize=11;fontColor=#4a3f6b;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="830" y="430" width="220" height="74" as="geometry" />
        </mxCell>
        <mxCell id="z3-instructions" value="&lt;b&gt;Instructions Maintenance Agent (prompt-based)&lt;/b&gt;&lt;br&gt;Reviews test artifacts/results, then proposes refinements to agent instructions to eliminate azcli script or logic errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b5b95;strokeWidth=1.5;fontSize=11;fontColor=#4a3f6b;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="800" y="690" width="270" height="86" as="geometry" />
        </mxCell>
        <mxCell id="zaz-policy" value="&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(51, 100, 91), rgb(128, 170, 162));&quot;&gt;Azure Policy Definitions &amp;amp; Assignments&lt;/b&gt;&lt;br&gt;&lt;/div&gt;Deployed to enforce policy&#39;s rules and effects then destroyed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f8a80;strokeWidth=1.5;fontSize=11;fontColor=#33645b;align=center;verticalAlign=middle;" parent="1" vertex="1">
